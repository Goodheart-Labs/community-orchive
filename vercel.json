{
  "buildCommand": "python3 build.py",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    { "source": "/orchive.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
